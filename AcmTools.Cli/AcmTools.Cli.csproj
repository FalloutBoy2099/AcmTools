<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AcmTools\AcmTools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AcmTools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>2026.10.11.5</AssemblyVersion>
    <FileVersion>2026.10.11.5</FileVersion>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>AcmTools.Cli</PackageId>
    <Description>Command line tool to convert Fallout/Interplay ACM audio to and from WAV, MP3, OGG, FLAC and more (install with: dotnet tool install -g AcmTools.Cli).</Description>
    <PackageTags>fallout;interplay;acm;audio;converter;tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/FalloutBoy2099/AcmTools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/FalloutBoy2099/AcmTools</PackageProjectUrl>
    <ToolCommandName>acmconverter</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>